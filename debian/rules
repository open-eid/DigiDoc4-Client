#!/usr/bin/make -f
# SPDX-FileCopyrightText: Estonian Information System Authority
# SPDX-License-Identifier: LGPL-2.1-or-later

%:
	dh $@

# dh_auto_test runs the unit tests with ctest; DEB_BUILD_OPTIONS=nocheck skips building them
override_dh_auto_configure:
	dh_auto_configure -- -DBUILD_TESTING=$(if $(filter nocheck,$(DEB_BUILD_OPTIONS)),OFF,ON)

override_dh_builddeb:
	dh_builddeb -- -Zgzip
