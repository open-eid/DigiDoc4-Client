  <property name="styleSheet">
   <string notr="true">#AddressItem {
border-bottom: 1px solid #E7EAEF;
background-color: #FFFFFF;
}
#AddressItem[card=&quot;true&quot;] {
border: 1px solid #E7EAEF;
border-radius: 4px;
}
#AddressItem:disabled {
background-color: #F0F0F2;
}
#AddressItem &gt; QWidget {
font-family: Roboto, Helvetica;
}
#name {
color: #07142A;
font-size: 14px;
font-weight: 700;
}
QLabel[label] {
font-size: 12px;
padding: 2px 8px;
border-radius: 8px;
}
QLabel[label=&quot;default&quot;] {
color: #07142A;
background: #F3F5F7;
}
QLabel[label=&quot;error&quot;] {
color: #AD2A45;
background: #F5EBED;
}
QLabel[label=&quot;good&quot;] {
color: #1A641B;
background: #EAF8EA;
}
#tile {
background-color: #F3F5F7;
border-radius: 4px;
}
#tile[checked=&quot;true&quot;] {
background-color: #EAF1F8;
}
#tile QLabel {
color: #07142A;
font-size: 14px;
}
#tile QLabel:disabled {
color: #C4CBD8;
}
QCheckBox::indicator {
width: 16px;
height: 16px;
}
QCheckBox::indicator:unchecked {
image: url(:/images/icon_checkbox.svg);
}
QCheckBox::indicator:unchecked:hover, QCheckBox::indicator:unchecked:focus {
image: url(:/images/icon_checkbox_active.svg);
}
QCheckBox::indicator:unchecked:disabled {
image: url(:/images/icon_checkbox_disabled.svg);
}
QCheckBox::indicator:checked {
image: url(:/images/icon_checkbox_check.svg);
}
QCheckBox::indicator:checked:hover, QCheckBox::indicator:checked:focus {
image: url(:/images/icon_checkbox_check_active.svg);
}
QCheckBox::indicator:checked:disabled {
image: url(:/images/icon_checkbox_check_disabled.svg);
}
#add {
padding: 9px 8px;
font-size: 12px;
font-weight: 700;
border-radius: 4px;
border: none;
color: #2F70B6;
}
#add:hover, #add:focus {
background-color: #EAF1F8;
}
#add:pressed {
background-color: #BFD3E8;
}
#decrypt {
padding: 10px 12px;
font-size: 14px;
font-weight: 700;
border-radius: 4px;
border: none;
color: #FFFFFF;
background-color: #2F70B6;
}
#decrypt:hover, #decrypt:focus {
background-color: #2B66A6;
}
#decrypt:pressed {
background-color: #215081;
}
#decrypt:disabled {
background-color: #82A9D3;
}
#remove:hover, #remove:focus {
icon: url(:/images/icon_remove_hover.svg);
}
#remove:pressed {
icon: url(:/images/icon_remove_clicked.svg);
}</string>
