  <property name="styleSheet">
   <string notr="true">QLabel {
color: #07142A;
}
#startScreen, #warnings {
background-color: #FFFFFF;
}
#signPage, #cryptoPage {
background-image: url(:/images/bg_lovid.svg);
background-repeat: repeat-x;
background-position: bottom;
}
#signIntroButton, #cryptoIntroButton {
padding: 14px 26px;
border-radius: 4px;
font-family: Roboto, Helvetica;
font-size: 16px;
font-weight: 700;
color: #ffffff;
background-color: #2F70B6;
}
#signIntroButton:hover, #signIntroButton:focus,
#cryptoIntroButton:hover, #cryptoIntroButton:focus {
background-color: #2B66A6;
}
#signIntroButton:pressed, #cryptoIntroButton:pressed {
background-color: #215081;
}
#signIntroLabel, #cryptoIntroLabel {
font-family: Roboto, Helvetica;
font-size: 18px;
font-weight: 400;
}</string>
