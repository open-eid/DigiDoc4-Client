   <string notr="true">QWidget {
font-family: Roboto, Helvetica;
font-size: 14px;
color: #07142A;
}
QCheckBox {
border-right: none; /*Workaround for right padding*/
color: #2F70B6;
font-family: Roboto, Helvetica;
font-size: 16px;
font-weight: 700;
}
QCheckBox::indicator {
width: 24px;
height: 24px;
}
QCheckBox::indicator:checked {
image: url(:/images/accordion_arrow_down.svg);
}
QCheckBox::indicator:unchecked {
image: url(:/images/accordion_arrow_right.svg);
}
QScrollBar {
border: none;
background: transparent;
}
QScrollBar:vertical {
width: 12px;
padding: 4px 4px 4px 0px;
margin: 0px;
}
QScrollBar:horizontal {
height: 10px;
padding: 0px 4px 4px 4px;
margin: 0px;
}
QScrollBar::handle:vertical {
background-color: #B5BFCF;
border: none;
margin: 0px;
border-radius: 4px;
min-height: 16px;
}
QScrollBar::handle:horizontal {
background-color: #B5BFCF;
border: none;
margin: 0px;
border-radius: 3px;
min-width: 16px;
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
height: 0px;
border: none;
background: none;
}
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
width: 0px;
border: none;
background: none;
}
QScrollBar::add-page,
QScrollBar::sub-page {
background: transparent;
}
#SignatureDialog {
background-color: #FFFFFF;
border-radius: 8px;
}
#lblSignerHeader, #lblSignatureHeader {
font-size: 22px;
color: #003168;
}
#status, #warning, #lblNotice {
font-size: 12px;
color: #091A36;
padding: 2px 10px;
border-radius: 8px;
background-color: #F3F5F7;
}
#lblNotice {
font-size: 14px;
}
#status[label=&quot;error&quot;], #warning[label=&quot;error&quot;], #lblNotice[label=&quot;error&quot;] {
color: #AD2A45;
background-color: #F5EBED;
}
#status[label=&quot;warning&quot;], #warning[label=&quot;warning&quot;], #lblNotice[label=&quot;warning&quot;] {
color: #83612D;
background-color: #FDF7EE;
}
#status[label=&quot;good&quot;], #warning[label=&quot;good&quot;], #lblNotice[label=&quot;good&quot;] {
color: #1A641B;
background-color: #EAF8EA;
}</string>
