<ui version="4.0">
 <class>SigningDialog</class>
 <widget class="QDialog" name="SigningDialog">
  <property name="windowModality">
   <enum>Qt::WindowModal</enum>
  </property>
  <property name="geometry">
   <rect>
    <x>0</x>
